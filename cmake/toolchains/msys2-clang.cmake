if(NOT DEFINED ENV{CLASH_NATIVE_MSYS2_BIN})
    message(FATAL_ERROR "CLASH_NATIVE_MSYS2_BIN must point to the selected MSYS2 bin directory")
endif()

file(TO_CMAKE_PATH "$ENV{CLASH_NATIVE_MSYS2_BIN}" CLASH_NATIVE_MSYS2_BIN)

if(NOT DEFINED ENV{CLASH_NATIVE_TARGET_ARCHITECTURE})
    set(CLASH_NATIVE_TARGET_ARCHITECTURE x64)
else()
    set(CLASH_NATIVE_TARGET_ARCHITECTURE "$ENV{CLASH_NATIVE_TARGET_ARCHITECTURE}")
endif()

if(CLASH_NATIVE_TARGET_ARCHITECTURE STREQUAL "x86")
    set(CLASH_NATIVE_SYSTEM_PROCESSOR x86)
    set(CLASH_NATIVE_COMPILER_TARGET i686-w64-windows-gnu)
elseif(CLASH_NATIVE_TARGET_ARCHITECTURE STREQUAL "x64")
    set(CLASH_NATIVE_SYSTEM_PROCESSOR x86_64)
    set(CLASH_NATIVE_COMPILER_TARGET x86_64-w64-windows-gnu)
else()
    message(FATAL_ERROR "Unsupported CLASH_NATIVE_TARGET_ARCHITECTURE: ${CLASH_NATIVE_TARGET_ARCHITECTURE}")
endif()

set(CMAKE_SYSTEM_NAME Windows CACHE STRING "" FORCE)
set(CMAKE_SYSTEM_PROCESSOR "${CLASH_NATIVE_SYSTEM_PROCESSOR}" CACHE STRING "" FORCE)
set(CMAKE_C_COMPILER "${CLASH_NATIVE_MSYS2_BIN}/clang.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${CLASH_NATIVE_MSYS2_BIN}/clang++.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_RC_COMPILER "${CLASH_NATIVE_MSYS2_BIN}/windres.exe" CACHE FILEPATH "" FORCE)

set(CMAKE_C_COMPILER_TARGET "${CLASH_NATIVE_COMPILER_TARGET}" CACHE STRING "" FORCE)
set(CMAKE_CXX_COMPILER_TARGET "${CLASH_NATIVE_COMPILER_TARGET}" CACHE STRING "" FORCE)
