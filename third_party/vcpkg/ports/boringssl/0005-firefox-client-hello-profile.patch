+// kFirefoxDelegatedCredentialSigalgs lists the signature schemes Firefox
+// offers for delegated credentials.
+static const uint16_t kFirefoxDelegatedCredentialSigalgs[] = {
+    SSL_SIGN_ECDSA_SECP256R1_SHA256,
+    SSL_SIGN_ECDSA_SECP384R1_SHA384,
