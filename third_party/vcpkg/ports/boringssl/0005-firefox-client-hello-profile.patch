 bool ssl_setup_extension_permutation(SSL_HANDSHAKE *hs) {
+  if (hs->config->client_hello_profile == CLASH_NATIVE_CLIENT_HELLO_FIREFOX) {
+    static_assert(sizeof(kFirefoxExtensionOrder) == kNumExtensions,
+                  "Firefox extension order must cover every extension");
+    if (!hs->extension_permutation.CopyFrom(kFirefoxExtensionOrder)) {
+      return false;
+    }
+    return true;
+  }
+
   if (!hs->config->permute_extensions) {
     return true;
   }
