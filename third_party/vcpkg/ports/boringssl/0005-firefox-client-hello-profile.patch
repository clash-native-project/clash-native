+};
+
+static bool ext_delegated_credential_add_clienthello(
+    const SSL_HANDSHAKE *hs, CBB *out, CBB *out_compressible,
+    ssl_client_hello_type_t type) {
+  if (hs->ssl->config->client_hello_profile != CLASH_NATIVE_CLIENT_HELLO_FIREFOX) {
+    return true;
+  }
+  CBB contents, sigalgs;
+  if (!CBB_add_u16(out_compressible, TLSEXT_TYPE_delegated_credential) ||
+      !CBB_add_u16_length_prefixed(out_compressible, &contents) ||
+      !CBB_add_u16_length_prefixed(&contents, &sigalgs)) {
+    return false;
+  }
+  for (uint16_t id : kFirefoxDelegatedCredentialSigalgs) {
+    if (!CBB_add_u16(&sigalgs, id)) {
+      return false;
+    }
+  }
+  return CBB_flush(out_compressible);
+}
