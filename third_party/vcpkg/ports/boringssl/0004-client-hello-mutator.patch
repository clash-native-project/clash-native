diff --git a/ssl/handshake_client.cc b/ssl/handshake_client.cc
index 4261735..efbf6e0 100644
--- a/ssl/handshake_client.cc
+++ b/ssl/handshake_client.cc
@@ -298,6 +298,33 @@ bool ssl_add_client_hello(SSL_HANDSHAKE *hs) {
     return false;
   }
 
+  if (type == ssl_client_hello_unencrypted && !SSL_is_dtls(ssl) &&
+      ssl->config->client_hello_mutator != nullptr) {
+    // Serialized layout: 4-byte handshake header, 2-byte legacy version,
+    // 32-byte random, u8 session ID length, session ID bytes.
+    static constexpr size_t kSessionIdLengthOffset = 4 + 2 + 32;
+    static constexpr size_t kSessionIdOffset = kSessionIdLengthOffset + 1;
+    static constexpr size_t kSessionIdLength = SSL_MAX_SSL_SESSION_ID_LENGTH;
+    if (msg.size() < kSessionIdOffset + kSessionIdLength ||
+        msg[kSessionIdLengthOffset] != kSessionIdLength) {
+      return false;
+    }
+    OPENSSL_memset(msg.data() + kSessionIdOffset, 0, kSessionIdLength);
+    if (!ssl->config->client_hello_mutator(
+            ssl, msg.data(), msg.size(), kSessionIdOffset, ssl->s3->client_random,
+            hs->has_offered_x25519_private ? hs->offered_x25519_private : nullptr,
+            ssl->config->client_hello_mutator_arg)) {
+      return false;
+    }
+    // Remember the rewritten session ID: servers echo the wire value in
+    // ServerHello for middlebox compatibility, and the echo check below must
+    // accept it. `hs->session_id` itself is left alone so resumption
+    // detection keeps comparing against the offered value.
+    OPENSSL_memcpy(hs->mutated_session_id, msg.data() + kSessionIdOffset,
+                   kSessionIdLength);
+    hs->session_id_mutated = true;
+  }
+
   return ssl->method->add_message(ssl, std::move(msg));
 }
 
