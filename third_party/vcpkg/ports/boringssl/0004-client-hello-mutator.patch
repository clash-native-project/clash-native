diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index ae9d737..102b56f 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5585,6 +5585,30 @@ OPENSSL_EXPORT int SSL_CTX_set_client_hello_profile(SSL_CTX *ctx, int profile);
 // for `ssl`. Returns 1 on success and 0 on unknown `profile`.
 OPENSSL_EXPORT int SSL_set_client_hello_profile(SSL *ssl, int profile);
 
+// ssl_client_hello_mutator_t inspects or rewrites a serialized client
+// ClientHello before it is emitted. `hello` points at `hello_len` mutable
+// bytes holding the full handshake message, including the 4-byte handshake
+// header. `session_id_offset` is the offset of the 32-byte session ID within
+// `hello`; BoringSSL zeroes those bytes before invoking the callback.
+// `client_random` is the 32-byte client random. `x25519_private` points at
+// the 32-byte private key of the offered X25519 key share, or is NULL when no
+// X25519 share is offered. The callback returns 1 to emit the (possibly
+// rewritten) message and 0 to abort the handshake.
+typedef int (*ssl_client_hello_mutator_t)(
+    SSL *ssl, uint8_t *hello, size_t hello_len, size_t session_id_offset,
+    const uint8_t client_random[32], const uint8_t *x25519_private, void *arg);
+
+// SSL_CTX_set_client_hello_mutator configures `ctx` to invoke `cb` with `arg`
+// on every client ClientHello before emission.
+OPENSSL_EXPORT void SSL_CTX_set_client_hello_mutator(
+    SSL_CTX *ctx, ssl_client_hello_mutator_t cb, void *arg);
+
+// SSL_set_client_hello_mutator configures `ssl` to invoke `cb` with `arg` on
+// its client ClientHello before emission.
+OPENSSL_EXPORT void SSL_set_client_hello_mutator(SSL *ssl,
+                                                 ssl_client_hello_mutator_t cb,
+                                                 void *arg);
+
 // SSL_max_seal_overhead returns the maximum overhead, in bytes, of sealing a
 // record with `ssl`.
 OPENSSL_EXPORT size_t SSL_max_seal_overhead(const SSL *ssl);
