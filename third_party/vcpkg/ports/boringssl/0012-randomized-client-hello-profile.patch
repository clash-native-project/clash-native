+// shuffle_cipher_order shuffles `count` cipher IDs in place (Fisher-Yates)
+// with randomness from RAND_bytes. The randomized profile varies the
+// ClientHello cipher order per handshake; modulo bias is irrelevant for
+// fingerprinting.
+static void shuffle_cipher_order(uint16_t *ciphers, size_t count) {
+  for (size_t i = count; i > 1; i--) {
+    uint8_t byte = 0;
+    if (RAND_bytes(&byte, sizeof(byte)) != 1) {
+      return;
+    }
+    const size_t j = byte % i;
+    const uint16_t tmp = ciphers[i - 1];
+    ciphers[i - 1] = ciphers[j];
+    ciphers[j] = tmp;
+  }
+}
