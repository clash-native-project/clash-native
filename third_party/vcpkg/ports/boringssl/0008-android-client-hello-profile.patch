@@ -293,6 +311,8 @@ static bool ssl_write_client_cipher_list(const SSL_HANDSHAKE *hs, CBB *out,
       legacy_order = kFirefoxLegacyCiphers;
     } else if (legacy_profile == CLASH_NATIVE_CLIENT_HELLO_SAFARI) {
