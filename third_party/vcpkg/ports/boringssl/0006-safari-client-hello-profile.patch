+// kSafariExtensionOrder lists kExtensions indices in the order Safari emits
+// them. Entries that stay silent when unconfigured may appear in any trailing
+// order. Padding is appended after the loop by the stock F5 workaround when
+// the record would otherwise land under 512 bytes, matching Safari.
+static const uint8_t kSafariExtensionOrder[] = {
+    0,   // server_name
+    2,   // extended_master_secret
