@@ -313,6 +331,8 @@ static bool ssl_write_client_cipher_list(const SSL_HANDSHAKE *hs, CBB *out,
       legacy_order = kSafariLegacyCiphers;
     } else if (legacy_profile == CLASH_NATIVE_CLIENT_HELLO_ANDROID) {
