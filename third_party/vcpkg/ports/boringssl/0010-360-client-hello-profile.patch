 // aspects are controlled through the regular configuration APIs.
 #define CLASH_NATIVE_CLIENT_HELLO_EDGE 6
 
+// CLASH_NATIVE_CLIENT_HELLO_360 selects the 360 Browser 7.5 ClientHello
+// emission profile: TLS 1.2-only legacy suites as raw IDs in 360 order,
+// raw signature algorithms, the old channel ID (30031), and extensions in
+// 360's fixed order. TLS 1.3 emission is skipped by capping the maximum
+// version at TLS 1.2 through the regular configuration APIs. All other
+// ClientHello aspects are controlled through the regular configuration APIs.
+#define CLASH_NATIVE_CLIENT_HELLO_360 7
+
 // SSL_CTX_set_client_hello_profile configures the ClientHello emission
 // profile for `ctx`. Returns 1 on success and 0 on unknown `profile`.
