+// CLASH_NATIVE_CLIENT_HELLO_DEFAULT selects the default ClientHello emission.
+#define CLASH_NATIVE_CLIENT_HELLO_DEFAULT 0
+// CLASH_NATIVE_CLIENT_HELLO_CHROME selects the Chrome ClientHello emission
+// profile: TLS 1.3 cipher suites in Chrome's fixed order and legacy cipher
+// suites in Chrome's fixed order. All other ClientHello aspects (extensions,
+// groups, GREASE) are controlled through the regular configuration APIs.
+#define CLASH_NATIVE_CLIENT_HELLO_CHROME 1
+
+// SSL_CTX_set_client_hello_profile configures the ClientHello emission
+// profile for `ctx`. Returns 1 on success and 0 on unknown `profile`.
+OPENSSL_EXPORT int SSL_CTX_set_client_hello_profile(SSL_CTX *ctx, int profile);
+
+// SSL_set_client_hello_profile configures the ClientHello emission profile
+// for `ssl`. Returns 1 on success and 0 on unknown `profile`.
+OPENSSL_EXPORT int SSL_set_client_hello_profile(SSL *ssl, int profile);
+
 // SSL_max_seal_overhead returns the maximum overhead, in bytes, of sealing a
 // record with `ssl`.
 OPENSSL_EXPORT size_t SSL_max_seal_overhead(const SSL *ssl);
