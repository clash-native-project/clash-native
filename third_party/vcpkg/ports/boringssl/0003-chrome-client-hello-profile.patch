+int SSL_CTX_set_client_hello_profile(SSL_CTX *ctx, int profile) {
+  if (profile != CLASH_NATIVE_CLIENT_HELLO_DEFAULT &&
+      profile != CLASH_NATIVE_CLIENT_HELLO_CHROME) {
+    return 0;
+  }
+  FromOpaque(ctx)->client_hello_profile = profile;
+  return 1;
+}
+
+int SSL_set_client_hello_profile(SSL *ssl, int profile) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return 0;
+  }
+  if (profile != CLASH_NATIVE_CLIENT_HELLO_DEFAULT &&
+      profile != CLASH_NATIVE_CLIENT_HELLO_CHROME) {
+    return 0;
+  }
+  ssl_impl->config->client_hello_profile = profile;
+  return 1;
+}
+
 int32_t SSL_get_ticket_age_skew(const SSL *ssl) {
   return FromOpaque(ssl)->s3->ticket_age_skew;
 }
